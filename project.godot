; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RetroOS - Ambient Retro Workstation Simulator"
config/description="An ambient retro operating system & workstation museum simulator featuring 20 historical computing environments spanning 1972 through 2012, procedural audio, authentic boot sequences, and archival codex exhibits."
run/main_scene="res://scenes/main/main_controller.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
AudioManager="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="RetroOS - Ambient Retro Workstation Simulator"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0392157, 0.0431373, 0.0509804, 1)
